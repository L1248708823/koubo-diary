# 本地联调配置。复制为 config/local-codex.env 后按本机路径调整。
# 本地 vault 是临时文件目录，不初始化 Git，也不连接远端。

VAULT_PATH=D:/path/to/koubo-diary/.temp-vaults/local/vault
VAULT_GIT_MODE=local

INGEST_TOKEN=local-test-token
INGEST_HOST=127.0.0.1
INGEST_PORT=8788
INGEST_PATH=/ingest
INGEST_CORS_ORIGIN=http://127.0.0.1:4173
CAPTURE_HOST=127.0.0.1
CAPTURE_PORT=4173
WAKE_MODE=none

LOCK_PATH=D:/path/to/koubo-diary/.temp-vaults/local/processor.lock
INBOX_DIR=_inbox
DIARY_DIR=生活/日子一天天过去
IDEAS_DIR=Yan帳/想法
RESEARCH_DIR=Yan帳/研究
PROCESSOR_DIR=_processor
STAGING_DIR=_staging
MAX_PER_ROUND=10
MAX_ATTEMPTS=3
# 研究任务每轮上限，不是整次唤醒的总条数上限
MAX_RESEARCH_PER_ROUND=5

AGENT_PROVIDER=codex
CODEX_BIN=codex.cmd
# 切 Claude 时改为：AGENT_PROVIDER=claude，并设置 CLAUDE_BIN=claude.cmd
PROCESSOR_SKILL=处理收件箱
LOG_AGENT_OUTPUT=1
