# 生产配置示例。实际密钥放到 VPS 的 EnvironmentFile，不要提交真实值。
# 进程可以从工具仓启动，但所有 Git 操作只针对 VAULT_PATH。

VAULT_PATH=/var/lib/koubo/vault
VAULT_GIT_MODE=remote
GIT_REMOTE=origin

INGEST_TOKEN=replace-with-a-long-random-token
INGEST_HOST=127.0.0.1
INGEST_PORT=8787
INGEST_PATH=/ingest
# 同域反代时可留空，否则填写捕捉端的精确 Origin
# INGEST_CORS_ORIGIN=https://capture.example.com

INBOX_DIR=_inbox
DIARY_DIR=生活/日子一天天过去
IDEAS_DIR=Yan帳/想法
RESEARCH_DIR=Yan帳/研究
PROCESSOR_DIR=_processor
STAGING_DIR=_staging
MAX_PER_ROUND=10
MAX_ATTEMPTS=3
LOCK_PATH=/run/koubo-processor.lock
WAKE_MODE=file
WAKE_FLAG_PATH=/run/koubo-processor.wake

AGENT_PROVIDER=codex
# CODEX_BIN=codex
# 或使用 Claude：AGENT_PROVIDER=claude、CLAUDE_BIN=claude
PROCESSOR_SKILL=处理收件箱
LOG_AGENT_OUTPUT=0
