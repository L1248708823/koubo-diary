{
  "name": "koubo-diary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "口播日记处理环：收件箱投递 + 编排验收 + 写回日记/想法",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "web:dev": "vite --config vite.config.ts",
    "web:build": "vite --config vite.config.ts build",
    "web:preview": "vite --config vite.config.ts preview",
    "processor": "tsx src/cli/run-processor.ts",
    "ingest": "tsx src/cli/run-ingest.ts",
    "local:setup": "node --env-file=config/local-codex.env scripts/setup-local-codex.mjs",
    "local:ingest": "node --env-file=config/local-codex.env node_modules/tsx/dist/cli.mjs src/cli/run-ingest.ts",
    "local:web": "node --env-file=config/local-codex.env node_modules/vite/bin/vite.js --config vite.config.ts",
    "local:processor": "node --env-file=config/local-codex.env node_modules/tsx/dist/cli.mjs src/cli/run-processor.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
