# 口播日记 · 环境变量示例
# 复制为 .env 后填写；.env 不进 git。

# 收件鉴权（捕捉端 Bearer）
INGEST_TOKEN=replace-me-with-a-long-random-string

# vault 本地 clone 路径（VPS 上的工作树）
VAULT_PATH=/var/lib/koubo/vault

# 目录名（可改成你真实 vault 的日记/想法目录）
INBOX_DIR=_inbox
DIARY_DIR=日记
IDEAS_DIR=想法
PROCESSOR_DIR=_processor
STAGING_DIR=_staging

# 编排参数
MAX_PER_ROUND=10
MAX_ATTEMPTS=3
LOCK_PATH=/run/koubo-processor.lock

# 收件 HTTP
INGEST_HOST=127.0.0.1
INGEST_PORT=8787
INGEST_PATH=/ingest

# 唤醒：投递成功后如何叫醒编排
# file = 写 flag 文件；callback = 进程内直接调编排（测试/单进程）
WAKE_MODE=file
WAKE_FLAG_PATH=/run/koubo-processor.wake

# 真 Claude（回来再填；假 agent 不需要）
# CLAUDE_BIN=claude
# ANTHROPIC_API_KEY=
# PROCESSOR_SKILL=处理收件箱

# git remote 名
GIT_REMOTE=origin
