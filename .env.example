# 口播日记 · 环境变量示例
# 复制为 .env 后填写；.env 不进 git。

# 收件鉴权（捕捉端 Bearer）
INGEST_TOKEN=replace-me-with-a-long-random-string

# 日记 vault 仓路径。生产 Git 只在此目录执行，绝不使用工具仓目录。
VAULT_PATH=/var/lib/koubo/vault
# remote：生产使用真实 Obsidian vault Git；local：本地联调完全跳过 Git
VAULT_GIT_MODE=remote
VAULT_REMOTE_URL=https://github.com/L1248708823/Obsidian

# 目录名（贴合真实 vault；见 docs/adr/0006 与 docs/ops/vault-layout.md）
INBOX_DIR=_inbox
# 日记为树前缀：其下还有 YYYY/YYYY-MM/YYYY-MM-DD.md
DIARY_DIR=生活/日子一天天过去
IDEAS_DIR=想法
PROCESSOR_DIR=_processor
STAGING_DIR=_staging

# 编排参数
MAX_PER_ROUND=10
MAX_ATTEMPTS=3
# 研究任务每轮上限，不是整次唤醒的总条数上限
MAX_RESEARCH_PER_ROUND=5
LOCK_PATH=/run/koubo-processor.lock
GIT_LOCK_PATH=/run/koubo-git.lock

# 收件 HTTP
INGEST_HOST=127.0.0.1
INGEST_PORT=8787
INGEST_PATH=/ingest
# 仅当前端与 ingest 跨域时填写精确 Origin；同域部署可留空
# INGEST_CORS_ORIGIN=https://capture.example.com

# 唤醒：投递成功后如何叫醒编排
# file = 写 flag 文件；callback = 进程内直接调编排（测试/单进程）
WAKE_MODE=file
WAKE_FLAG_PATH=/run/koubo-processor.wake

# Agent provider：必须明确选择，避免凭环境变量误切换
AGENT_PROVIDER=codex

# Codex CLI：Windows 通常是 codex.cmd，Linux/WSL 通常是 codex
# CODEX_BIN=codex.cmd
# Codex 返回模型容量不足时自动重跑；总重跑次数和初始等待时间可调整
MODEL_CAPACITY_RETRIES=2
MODEL_CAPACITY_RETRY_DELAY_MS=3000

# Claude CLI：需要切回 Claude 时改为 AGENT_PROVIDER=claude
# CLAUDE_BIN=claude.cmd
# ANTHROPIC_API_KEY=

PROCESSOR_SKILL=处理收件箱

# 本地文件日志目录。只在本地联调时开启；该目录已被 Git 忽略
# RUNTIME_LOG_DIR=./temp/runtime-logs
# LOG_CLEANUP_ON_SUCCESS=1
# LOG_RETENTION_MS=900000

# 研究阶段固定使用独立 Codex runner；参数由 runner 显式传给 CLI
RESEARCH_SKILL=research-brief
RESEARCH_MODEL=gpt-5.6-luna
RESEARCH_REASONING_EFFORT=max
RESEARCH_TIMEOUT_MS=900000
# RESEARCH_BIN=codex.cmd

# git remote 名
GIT_REMOTE=origin
